# ============================================================
# CareerPulse AI - Environment Configuration Variables
# ============================================================

# -----------------
# 1. API Backend Configuration
# -----------------
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# -----------------
# 2. Database (MongoDB Atlas)
# -----------------
# Provide your MongoDB Atlas connection string, or use the local MongoDB fallback
MONGODB_URI=mongodb://localhost:27017/careerpulse

# -----------------
# 3. Clerk Authentication
# -----------------
# Obtain these from Clerk Dashboard (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_careerpulse_key
CLERK_SECRET_KEY=sk_test_sample_careerpulse_secret
CLERK_WEBHOOK_SECRET=whsec_sample_webhook_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# -----------------
# 4. AI Provider (OpenRouter API)
# -----------------
# https://openrouter.ai/keys (Free or pay-as-you-go tiers available)
OPENROUTER_API_KEY=sk-or-v1-sample-openrouter-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=CareerPulse AI

# -----------------
# 5. External Job Feed APIs (Optional real feeds)
# -----------------
# JSearch via RapidAPI (Free tier: 500 requests/month)
RAPIDAPI_KEY=sample_rapidapi_key
RAPIDAPI_JSEARCH_HOST=jsearch.p.rapidapi.com

# Adzuna API (Free tier: 250 calls/month)
ADZUNA_APP_ID=sample_adzuna_app_id
ADZUNA_APP_KEY=sample_adzuna_app_key

# Remotive (Free public API, subject to terms)
REMOTIVE_API_ENABLED=true

# -----------------
# 6. Razorpay Subscriptions (India)
# -----------------
# https://dashboard.razorpay.com (Test Mode)
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret

# -----------------
# 7. Cloud Storage (Cloudinary - Optional for resume uploads)
# -----------------
CLOUDINARY_CLOUD_NAME=sample_cloud_name
CLOUDINARY_API_KEY=sample_api_key
CLOUDINARY_API_SECRET=sample_api_secret

# -----------------
# 8. Email Service (Optional for transaction notifications)
# -----------------
RESEND_API_KEY=re_sample_resend_key
FROM_EMAIL=notifications@careerpulse.ai
